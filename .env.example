# SIGH - Exemplo de variáveis de ambiente
#
# Copie para .env (ignorado pelo git) e troque TODOS os valores <troque-aqui>.
# Nunca versione o .env nem reutilize valores de exemplo/antigos do histórico do git.
#
# Backend (ASP.NET Core): "__" equivale a ":" na configuração.
# Em desenvolvimento, prefira user-secrets no projeto SIGH.Api, por exemplo:
#   dotnet user-secrets --project SIGH/backend/src/SIGH.Api set "JwtOptions:SecretKey" "<troque-aqui>"

# SQL Server (docker-compose.yml). Requisitos de complexidade do SQL Server:
# mínimo 8 caracteres com maiúsculas, minúsculas, dígitos e símbolos.
MSSQL_SA_PASSWORD=<troque-aqui>

# Connection string da API. Use a mesma senha definida em MSSQL_SA_PASSWORD
# (de preferência um usuário dedicado, não o sa, fora do ambiente local).
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=SIGH_DB;User Id=sa;Password=<troque-aqui>;TrustServerCertificate=True;

# JWT: SecretKey com pelo menos 32 bytes (UTF-8). Gere com: openssl rand -base64 48
JwtOptions__SecretKey=<troque-aqui>
JwtOptions__Issuer=SIGH.Api
JwtOptions__Audience=SIGH.Client

# Seed do primeiro acesso (usuário administrador com troca de senha obrigatória)
Seed__AdminEmail=<troque-aqui>
Seed__AdminPassword=<troque-aqui>
Seed__DefaultCompanyName=<troque-aqui>
