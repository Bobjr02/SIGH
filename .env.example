# SIGH - Environment Variables Example

# Frontend
VITE_API_URL=http://localhost:5000/api

# Database - SQL Server
DB_SERVER=localhost,1433
DB_NAME=SIGH_DB
DB_USER=sa
DB_PASSWORD=YourStrong@Password2026!
SA_PASSWORD=YourStrong@Password2026!

# Connection Strings
ConnectionStrings__DefaultConnection="Server=sqlserver,1433;Database=SIGH_DB;User Id=sa;Password=YourStrong@Password2026!;TrustServerCertificate=True;"

# JWT Settings (Dependencies only)
JwtSettings__SecretKey=SuperSecretKeyForSighSystem2026WithAtLeast256BitsLong!
JwtSettings__Issuer=SIGH.Api
JwtSettings__Audience=SIGH.Client
JwtSettings__ExpiryInMinutes=60

# Serilog
Serilog__MinimumLevel=Information
