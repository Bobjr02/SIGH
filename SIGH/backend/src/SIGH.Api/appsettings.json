{
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Seed": {
    "AdminEmail": "admin@sigh.com.br",
    "DefaultCompanyName": "Empresa Padrão"
  },
  "JwtOptions": {
    "Issuer": "SIGH.Api",
    "Audience": "SIGH.Client",
    "ExpiryInMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Storage": {
    "MaxUploadSizeBytes": 26214400,
    "Local": {
      "RootPath": ""
    }
  },
  "Auth": {
    "RefreshTokenReuseGraceSeconds": 30,
    "PasswordResetTokenMinutes": 30,
    "AccountSetupTokenHours": 72
  }
}
