# SIGH web: SPA + proxy reverso de /api/ para a API (mesma origem: o cookie HttpOnly do refresh token
# é de primeira parte e não há CORS). Processado pelo envsubst da imagem nginx-unprivileged na subida:
# ${SIGH_API_UPSTREAM} (padrão http://api:3000).
server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # API: o upload de evidências aceita até 25 MB (Storage:MaxUploadSizeBytes) + envelope multipart.
    location /api/ {
        proxy_pass ${SIGH_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        client_max_body_size 26m;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    # Assets com hash no nome: cache longo e imutável.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # index.html nunca em cache: um deploy novo aparece no próximo carregamento.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # SPA: qualquer rota do front cai no index.html.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri /index.html;
    }
}
