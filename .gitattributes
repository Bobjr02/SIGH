# Fim de linha fixo para os scripts funcionarem logo após o git clone, em qualquer sistema.
*.sh   text eol=lf
*.ps1  text eol=crlf
# Arquivos lidos dentro dos containers Linux (nginx, Dockerfile, compose) sempre com LF.
Dockerfile   text eol=lf
*.conf       text eol=lf
*.template   text eol=lf
*.yml        text eol=lf
